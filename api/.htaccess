<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /personelmedisa/api/

  # Deny live config and backup/temp derivatives (exact, suffix, tilde, slash-path).
  RewriteRule ^config\.local\.php(?:$|[./~_-].*) - [F,L,NC]
  RewriteRule ^(src|migrations|seeds)/ - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ public/index.php [L,QSA]
</IfModule>
